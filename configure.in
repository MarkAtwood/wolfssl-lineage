AC_INIT
AC_CANONICAL_SYSTEM
AM_INIT_AUTOMAKE(cyassl,0.3.0)
AM_CONFIG_HEADER(ctaocrypt/include/config.h)

# make sure configure doesn't add to CFLAGS
CFLAGS="$CFLAGS $C_EXTRA_FLAGS"    

AC_PROG_CC
AC_PROG_INSTALL
AC_PROG_RANLIB


AC_C_BIGENDIAN

AC_CHECK_SIZEOF(long, 4)
AC_CHECK_SIZEOF(long long, 8)


OPTIMIZE_CFLAGS=""
DEBUG_CFLAGS="-g"


AC_ARG_ENABLE(debug,
    [  --enable-debug          Enable CyaSSL debugging support (default: disabled)],
    [ ENABLED_DEBUG=$enableval ],
    [ ENABLED_DEBUG=no ]
    )
if test "$ENABLED_DEBUG" = "yes"
then
  # Full debug. Very slow in some cases
  CFLAGS="$DEBUG_CFLAGS $CFLAGS"
else
  # Optimized version. No debug
  CFLAGS="$OPTIMIZE_CFLAGS $CFLAGS -DNDEBUG"
fi


if test "$GCC" = "yes"
then
    if test "$ENABLED_DEBUG" = "no"
    then
        CFLAGS="$CFLAGS -Os -fomit-frame-pointer"
    fi
fi


AC_SUBST(CFLAGS)



if expr "$target_os" : "solaris" > /dev/null
then
    EXTRA_SOCKET="-lnsl -lsocket"
else
    EXTRA_SOCKET=""
fi
AC_SUBST(EXTRA_SOCKET)


if expr "$target_os" : ".*bsd.*" > /dev/null
then
    if expr "$target_os" : "netbsd.*" > /dev/null
    then
        EXTRA_PTHREAD="-lpthread"
    else
        EXTRA_PTHREAD="-pthread"
    fi
else
    EXTRA_PTHREAD="-lpthread"
fi
AC_SUBST(EXTRA_PTHREAD)


if expr "$target_os" : "netbsd.*" > /dev/null
then
    PTHREAD_CFLAGS=`pthread-config --cflags`
    PTHREAD_LDFLAGS=`pthread-config --ldflags`
else
    PTHREAD_CFLAGS=""
    PTHREAD_LDFLAGS=""
fi
AC_SUBST(PTHREAD_CFLAGS)
AC_SUBST(PTHREAD_LDFLAGS)



AC_CONFIG_FILES(Makefile dnl
        ctaocrypt/Makefile dnl
        ctaocrypt/src/Makefile dnl
        ctaocrypt/test/Makefile dnl
        ctaocrypt/benchmark/Makefile dnl
        src/Makefile dnl
        examples/Makefile dnl
        examples/client/Makefile dnl
        examples/server/Makefile dnl
        examples/echoclient/Makefile dnl
        examples/echoserver/Makefile)

AC_OUTPUT

