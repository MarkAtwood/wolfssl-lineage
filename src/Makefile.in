INCLUDES = -I../include -I../ctaocrypt/include

lib_LTLIBRARIES = libcyassl.la
libcyassl_la_SOURCES = cyassl_int.c keys.c ssl.c tls.c ../ctaocrypt/src/arc4.c \
    ../ctaocrypt/src/asn.c ../ctaocrypt/src/coding.c ../ctaocrypt/src/des3.c \
    ../ctaocrypt/src/hmac.c ../ctaocrypt/src/integer.c ../ctaocrypt/src/md5.c \
    ../ctaocrypt/src/random.c ../ctaocrypt/src/rsa.c ../ctaocrypt/src/sha.c \
    ../ctaocrypt/src/aes.c ../ctaocrypt/src/sha256.c

libcyassl_la_LDFLAGS = -no-undefined -version-info 0:0:0
AM_CFLAGS = -Wall
EXTRA_DIST = ../include/*.h ../include/openssl/*.h
subdir = src
ACLOCAL_M4 = $(top_srcdir)/aclocal.m4
mkinstalldirs = $(SHELL) $(top_srcdir)/mkinstalldirs
CONFIG_HEADER = $(top_builddir)/ctaocrypt/include/config.h
CONFIG_CLEAN_FILES =
LTLIBRARIES = $(lib_LTLIBRARIES)

libcyassl_la_LIBADD =
am_libcyassl_la_OBJECTS = cyassl_int.lo keys.lo ssl.lo tls.lo arc4.lo \
	asn.lo coding.lo des3.lo hmac.lo integer.lo md5.lo random.lo \
	rsa.lo sha.lo aes.lo sha256.lo
libcyassl_la_OBJECTS = $(am_libcyassl_la_OBJECTS)

DEFAULT_INCLUDES =  -I. -I$(srcdir) -I$(top_builddir)/ctaocrypt/include
depcomp = $(SHELL) $(top_srcdir)/depcomp
am__depfiles_maybe = depfiles
